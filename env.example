# Copia in .env e riempi i valori (serve solo per girare in locale)

# Modello. Predefinito: Gemini nel piano gratuito, chiave da aistudio.google.com
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Alternative gratuite, se preferisci
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Mail
MAIL_TO=tua-mail@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua-mail@gmail.com
SMTP_PASS=password-per-le-app-di-16-caratteri

# Facoltativo: chiave gratuita di football-data.org, rende il calendario più affidabile
FOOTBALL_DATA_TOKEN=
